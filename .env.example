# ─── WordPress ────────────────────────────────────────────────────────────────

# Your WordPress site URL — no trailing slash
WP_URL=https://your-wordpress-site.com

# Your WordPress login username (not email, not display name)
WP_USERNAME=your_username

# Application password — generate at:
# WP Admin → Users → Your Profile → scroll to "Application Passwords" → Add New
# Copy the generated password exactly (spaces are fine, or remove them)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ─── Claude Connector Auth ─────────────────────────────────────────────────────
#
# Generate with:  openssl rand -hex 32
#
# In Claude's custom connector settings, set Authentication to "No sign-in",
# then under "Request headers" add:
#   Header name: Authorization
#   Value:       Bearer <same value as below>

MCP_BEARER_TOKEN=replace-with-output-of-openssl-rand-hex-32

# ─── Server ───────────────────────────────────────────────────────────────────

# Port the server listens on inside Docker.
# Must match what your Cloudflare Tunnel / nginx proxy points to.
PORT=9809

# ─── Google Gemini / Imagen 3 ─────────────────────────────────────────────────
#
# Required for the generate_image and generate_image_for_post tools.
# Get your API key at: https://aistudio.google.com/apikey
#
GEMINI_API_KEY=your-gemini-api-key-here
